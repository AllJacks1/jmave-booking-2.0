# Copy to .env.local for local development. Names only — never commit values.
# Production values live in Railway Variables.

# --- Phase 1a ---------------------------------------------------------------
# Postgres connection string.
DATABASE_URL=
# Random string, at least 32 characters (session signing).
BETTER_AUTH_SECRET=
# Public base URL, e.g. https://app.jmavecars.com (http://localhost:3000 locally).
APP_URL=
# One-time token required by /setup to create the first Super Admin.
SETUP_TOKEN=

# --- Phase 3 ----------------------------------------------------------------
# Used by the worker only (web requests never call Resend). EMAIL_FROM like
# "J-MaVe Cars <quotes@yourdomain>". Run the worker locally: pnpm worker:dev
RESEND_API_KEY=
EMAIL_FROM=

# --- Phase 4 ----------------------------------------------------------------
# Rework lead webhook (web shows set/not set; the worker sends). The token is a
# URL parameter: never log it.
REWORK_WEBHOOK_URL=
REWORK_WEBHOOK_TOKEN=
# Cloudflare Turnstile for the public booking page. Without the secret,
# production refuses public submissions; development skips the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma list of origins allowed to iframe /book, e.g. https://www.jmavecars.com
PUBLIC_EMBED_ORIGINS=
# Public booking hostname(s), e.g. book.jmavecars.com: every path there is
# served from /book and staff pages are not served.
PUBLIC_BOOK_HOST=

# --- Local testing only (not used on Railway) --------------------------------
# Throwaway databases; names must end in _test / _e2e (they are wiped).
TEST_DATABASE_URL=
E2E_DATABASE_URL=
