# Copy to .env.local for local development. Names only — never commit values.
# Production values live in Railway Variables.

# --- Phase 1a ---------------------------------------------------------------
# Postgres connection string.
DATABASE_URL=
# Random string, at least 32 characters (session signing).
BETTER_AUTH_SECRET=
# Public base URL, e.g. https://app.jmavecars.com (http://localhost:3000 locally).
APP_URL=
# One-time token required by /setup to create the first Super Admin.
SETUP_TOKEN=

# --- Phase 3 ----------------------------------------------------------------
# Used by the worker only (web requests never call Resend). EMAIL_FROM like
# "J-MaVe Cars <quotes@yourdomain>". Run the worker locally: pnpm worker:dev
RESEND_API_KEY=
EMAIL_FROM=

# --- Phase 4 ----------------------------------------------------------------
# Rework lead webhook (web shows set/not set; the worker sends). The token is a
# URL parameter: never log it.
REWORK_WEBHOOK_URL=
REWORK_WEBHOOK_TOKEN=
# Cloudflare Turnstile for the public booking page. Without the secret,
# production refuses public submissions; development skips the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma list of origins allowed to iframe /book, e.g. https://www.jmavecars.com
PUBLIC_EMBED_ORIGINS=
# Public booking hostname(s), e.g. book.jmavecars.com: every path there is
# served from /book and staff pages are not served.
PUBLIC_BOOK_HOST=

# --- Phase 5 ----------------------------------------------------------------
# Sentry error reports (web + worker). Empty = disabled. On Railway each service
# can use its own SENTRY_DSN; locally the worker reads SENTRY_WORKER_DSN first.
SENTRY_DSN=
SENTRY_WORKER_DSN=
# Browser DSN, inlined at build time (same web project DSN).
NEXT_PUBLIC_SENTRY_DSN=
# e.g. production / staging (defaults to RAILWAY_ENVIRONMENT_NAME).
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: upload source maps at build time (Railway build only, never commit).
SENTRY_AUTH_TOKEN=
# Optional: 0–1 share of server requests traced (default 0).
SENTRY_TRACES_SAMPLE_RATE=
# Proxies in front of the app that append to X-Forwarded-For (default 1 =
# Railway's edge; 2 if a CDN such as Cloudflare sits in front of Railway).
TRUSTED_PROXY_HOPS=
# Optional: "debug" to print debug log lines.
LOG_LEVEL=
# Off-site nightly pg_dump (optional; the job stays off until all are set).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=

# --- Local testing only (not used on Railway) --------------------------------
# Throwaway databases; names must end in _test / _e2e (they are wiped).
TEST_DATABASE_URL=
E2E_DATABASE_URL=
